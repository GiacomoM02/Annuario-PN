# --- Vercel Postgres ---
# Generati automaticamente collegando un DB "Vercel Postgres" (Neon) al progetto da dashboard Vercel.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# --- Vercel Blob ---
# Generato automaticamente creando uno Store "Blob" collegato al progetto.
BLOB_READ_WRITE_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chiave per contare gli invii per email senza salvare gli indirizzi.
EMAIL_HASH_SECRET=

# Impronta (hash) della password del pannello /admin: si crea con
# `npm run admin:hash`. La password in chiaro non va mai scritta qui.
ADMIN_PASSWORD_HASH=

# Facoltativa: cambiandola (e rifacendo il deploy) si chiudono tutte le
# sessioni aperte del pannello admin.
ADMIN_SESSION_VERSION=

# Nota: la verifica email via OTP (Upstash Redis + Resend) è stata rimossa
# per semplicità. Il form controlla solo che l'indirizzo termini con
# @unipi.it o @studenti.unipi.it, senza inviare alcun codice.
