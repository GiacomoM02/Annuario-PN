# --- Vercel Postgres ---
# Generati automaticamente collegando un DB "Vercel Postgres" (Neon) al progetto da dashboard Vercel.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# --- Vercel Blob ---
# Generato automaticamente creando uno Store "Blob" collegato al progetto.
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (per gli OTP: storage volatile, TTL, MAI persistente) ---
# Creabile gratuitamente da Vercel Marketplace > Upstash, oppure upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (invio email OTP) ---
# https://resend.com — piano free sufficiente per bassi volumi
RESEND_API_KEY=
RESEND_FROM_EMAIL="Annuario del PN <onboarding@resend.dev>"

# --- Sicurezza token di verifica ---
# Stringa casuale lunga, usata per firmare il token "email verificata" (HMAC).
# Generane una con: openssl rand -base64 32
OTP_SIGNING_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
